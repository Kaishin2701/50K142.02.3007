# Copy to .env and supply the PostgreSQL connection string from Supabase.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_DATABASE_HOST:5432/postgres
PG_SSL=true
PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NODE_ENV=development
SESSION_HOURS=12
# Required only for the one-time administrator bootstrap (npm run seed).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_PHONE=
# Optional payment gateway contract; disabled until configured.
QR_GATEWAY_URL=
QR_GATEWAY_TOKEN=
QR_WEBHOOK_SECRET=
QR_PROVIDER=disabled
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_API_KEY=
TRUST_PROXY=0
# Optional Unicode TTF/OTF override. The bundled Plus Jakarta Sans font is the default.
PDF_FONT_PATH=
